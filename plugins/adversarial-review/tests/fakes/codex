#!/usr/bin/env python3
"""A fake `codex` for the tests: never the real binary, never the network.

FAKE_CODEX_REPLY  path of a file whose text is written to the -o file (default: a minimal valid APPROVED)
FAKE_CODEX_LOG    when set, {argv, stdin, env} is appended to it as one JSON line (stdin must be empty: DEVNULL; env is
                  the sorted list of the variable NAMES it received)
FAKE_CODEX_MODE   "fail" exits 1 with "boom" on stderr; "badutf8" exits 1 with invalid UTF-8 on stderr; "hang" sleeps 30 s;
                  "stderr" exits 1 printing FAKE_CODEX_STDERR on stderr
"""
import json, os, sys, time

argv = sys.argv[1:]
if argv[:1] == ["--version"]:
    print("codex-cli 0.0.0-fake")
    sys.exit(0)

if os.environ.get("FAKE_CODEX_LOG"):
    with open(os.environ["FAKE_CODEX_LOG"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": argv, "stdin": sys.stdin.read(), "env": sorted(os.environ)}) + "\n")

mode = os.environ.get("FAKE_CODEX_MODE")
if mode == "fail":
    sys.stderr.write("boom")
    sys.exit(1)
if mode == "stderr":
    sys.stderr.write(os.environ.get("FAKE_CODEX_STDERR", ""))
    sys.exit(1)
if mode == "badutf8":
    sys.stderr.buffer.write(b"bad \xff\xfe bytes")
    sys.stderr.flush()
    sys.exit(1)
if mode == "hang":
    time.sleep(30)

if argv[:1] == ["exec"] and "-o" in argv:
    out = argv[argv.index("-o") + 1]
    reply = os.environ.get("FAKE_CODEX_REPLY")
    if reply:
        with open(reply, encoding="utf-8") as f:
            text = f.read()
    else:
        text = json.dumps({"verdict": "APPROVED", "summary": "fake codex approves", "findings": [],
                           "spec_promises_without_task": []})
    with open(out, "w", encoding="utf-8") as f:
        f.write(text)
